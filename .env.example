# Server Configuration
# The port on which the Node.js backend server will run.
PORT=3001

# Third-party Weather API Configuration
# Your API key for the external weather service (e.g., OpenWeatherMap, WeatherAPI.com).
# Obtain this from your chosen weather API provider.
WEATHER_API_KEY=your_weather_api_key_here

# The base URL for the third-party weather API.
# Example for OpenWeatherMap: https://api.openweathermap.org/data/2.5
WEATHER_API_BASE_URL=https://api.example.com/weather/v1

# Security Configuration
# The origin(s) allowed to make requests to this backend.
# For multiple origins, separate them with commas (e.g., http://localhost:3000,https://your-frontend-domain.com).
# In development, typically http://localhost:3000 for the React client.
CORS_ORIGIN=http://localhost:3000

# Client Configuration (for React app)
# These variables will be exposed to the client-side bundle.
# They MUST be prefixed with REACT_APP_
# The URL where the React frontend can reach the Node.js backend proxy.
REACT_APP_BACKEND_URL=http://localhost:3001

# Cross-Project Context / Microservice Integration (Optional)
# These variables are placeholders to simulate an interconnected architecture.
# They might not be directly used by the Weather Dashboard but represent
# potential integration points with other services in the ecosystem.

# URL for a shared authentication service (e.g., from an 'Auth Service' project).
# AUTH_SERVICE_URL=http://localhost:3002/api/auth

# URL for a custom URL shortener service (e.g., from the 'Custom URL Shortener' project).
# Might be used if the dashboard needed to share short links to specific weather forecasts.
# URL_SHORTENER_SERVICE_URL=http://localhost:3003/api/shorten

# URL for an AI-powered content assistant service.
# Could be used to generate weather-related insights or summaries.
# AI_CONTENT_ASSISTANT_URL=http://localhost:3004/api/generate-content

# URL for an e-commerce product catalog service.
# Could be used to suggest products based on weather conditions (e.g., umbrellas for rain).
# ECOMMERCE_CATALOG_URL=http://localhost:3005/api/products